# Application
APP_URL=http://localhost:3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/modera?schema=public
# Use `neon-http` for read-oriented local access to a Neon-hosted database.
# Defaults to the standard PostgreSQL driver, which supports transactions.
DATABASE_ADAPTER=pg

# Initial owner account (used by `npm run db:seed`)
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Владелец

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret
TELEGRAM_WEBHOOK_URL=https://example.com/api/telegram/webhook

# Session
SESSION_TTL_DAYS=14
