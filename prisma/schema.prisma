generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  OWNER
  ADMIN
  MODERATOR
  VIEWER
}

enum BotChatStatus {
  ACTIVE
  CONNECTED
  NOT_ADMIN
  INSUFFICIENT_PERMISSIONS
  REMOVED
  DISABLED
  TELEGRAM_ERROR
}

enum AuditSource {
  TELEGRAM
  ADMIN
  SYSTEM
}

enum MembershipStatus {
  CREATOR
  ADMINISTRATOR
  MEMBER
  RESTRICTED
  PENDING
  LEFT
  BANNED
  UNKNOWN
}

enum ModerationActionType {
  WARNING
  MUTE
  UNMUTE
  BAN
  UNBAN
  KICK
}

enum ModerationActionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  DECLINED
  // Telegram no longer has this request (withdrawn by the user, or resolved
  // by a live admin directly in Telegram, outside this panel) -- discovered
  // only when an admin here tries to act on it and Telegram's API rejects
  // the call (e.g. "HIDE_REQUESTER_MISSING"), since Telegram sends no event
  // when a request disappears on its own.
  EXPIRED
}

enum AppealStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

// Chat-scoped self-service admin access (see chat-admin-access-service.ts).
// GLOBAL is every existing/manually-created AdminUser (unchanged behavior,
// sees every chat). CHAT is a self-registered-via-Telegram-login account
// scoped only to chats it has a ChatAdminAccess row for.
enum AdminScope {
  GLOBAL
  CHAT
}

enum ChatAdminAccessRole {
  OWNER
  ADMIN
  MODERATOR
}

model TelegramBot {
  id              String    @id @default(uuid()) @db.Uuid
  telegramBotId   BigInt    @unique
  username        String?
  firstName       String
  isActive        Boolean   @default(true)
  lastCheckedAt   DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  chats           BotChat[]

  @@index([isActive])
}

model Chat {
  id                 String                  @id @default(uuid()) @db.Uuid
  telegramChatId     BigInt                  @unique
  title              String
  username           String?
  type               String
  photoFileId        String?
  avatarSyncedAt     DateTime?               @db.Timestamptz(3)
  knownMemberCount   Int?
  firstSeenAt        DateTime                @default(now()) @db.Timestamptz(3)
  lastActivityAt     DateTime                @default(now()) @db.Timestamptz(3)
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(3)
  botLinks                 BotChat[]
  members                  ChatMember[]
  messages                 Message[]
  joinRequests             JoinRequest[]
  moderationSettings       ChatModerationSettings?
  captchaSettings          ChatCaptchaSettings?
  antiRaidSettings         ChatAntiRaidSettings?
  raidIncidents            RaidIncident[]
  manualModerationSettings ChatManualModerationSettings?
  moderationActions        ModerationAction[]
  auditLogs                AuditLog[]
  appeals                  Appeal[]
  reports                  Report[]
  reportSettings           ChatReportSettings?
  logChannelSettings       ChatLogChannelSettings?
  contentSettings          ChatContentSettings?
  silenceState             ChatSilenceState?
  autoResponseRules        AutoResponseRule[]
  customCommands           CustomCommand[]
  adminAccess              ChatAdminAccess[]
  appealSettings           ChatAppealSettings?
  inviteLinks              ChatInviteLink[]

  @@index([lastActivityAt(sort: Desc)])
  @@index([type])
}

model BotChat {
  id               String        @id @default(uuid()) @db.Uuid
  botId            String        @db.Uuid
  chatId           String        @db.Uuid
  telegramStatus   String?
  status           BotChatStatus @default(CONNECTED)
  permissions      Json?
  lastError        String?
  firstSeenAt      DateTime      @default(now()) @db.Timestamptz(3)
  lastSeenAt       DateTime      @default(now()) @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)
  bot              TelegramBot   @relation(fields: [botId], references: [id], onDelete: Cascade)
  chat             Chat          @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([botId, chatId])
  @@index([chatId, status])
  @@index([botId, status])
}

model TelegramUser {
  id                String             @id @default(uuid()) @db.Uuid
  telegramUserId    BigInt             @unique
  username          String?
  firstName         String
  lastName          String?
  displayName       String
  isBot             Boolean            @default(false)
  isPremium         Boolean            @default(false)
  addedToAttachmentMenu Boolean        @default(false)
  languageCode      String?
  avatarFileId      String?
  avatarSyncedAt    DateTime?          @db.Timestamptz(3)
  firstSeenAt       DateTime           @default(now()) @db.Timestamptz(3)
  lastSeenAt        DateTime           @default(now()) @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  memberships       ChatMember[]
  messages          Message[]
  joinRequests      JoinRequest[]
  moderationActions ModerationAction[] @relation("ModeratedUser")
  auditLogs         AuditLog[]         @relation("AffectedUser")
  appeals           Appeal[]
  reportsFiled      Report[]           @relation("ReportReporter")
  reportsReceived   Report[]           @relation("ReportReportedUser")

  @@index([username])
  @@index([lastSeenAt(sort: Desc)])
}

model ChatMember {
  id                             String           @id @default(uuid()) @db.Uuid
  chatId                         String           @db.Uuid
  userId                         String           @db.Uuid
  status                         MembershipStatus @default(UNKNOWN)
  internalRole                   String?
  telegramCustomTitle            String?          @db.VarChar(16)
  joinedAt                       DateTime?        @db.Timestamptz(3)
  leftAt                         DateTime?        @db.Timestamptz(3)
  firstSeenAt                    DateTime          @default(now()) @db.Timestamptz(3)
  lastSeenAt                     DateTime          @default(now()) @db.Timestamptz(3)
  lastTelegramUpdateId           BigInt?
  lastModerationAt               DateTime?        @db.Timestamptz(3)
  messageCount                   Int               @default(0)
  warningCount                   Int               @default(0)
  lastAutoEscalationWarningCount Int               @default(0)
  // Per-level "reset counter on trigger" (EscalationRuleValue.resetWarningsOnTrigger)
  // sets this to now() instead of leaving lastAutoEscalationWarningCount at the
  // fired threshold. countActiveWarningRecords/countActiveWarnings then floor
  // their window at max(warningExpiryDays cutoff, this) -- older WARNING rows
  // stay in history (/warns, /info, member profile) untouched, they just stop
  // counting toward the next escalation cycle.
  warningsResetAt                DateTime?         @db.Timestamptz(3)
  selfUnmuteCount                Int               @default(0)
  punishmentState                String?
  punishmentExpiresAt            DateTime?         @db.Timestamptz(3)
  // Captcha challenge is sent as an ephemeral message (Bot API 10.2,
  // receiver_user_id) -- the real id is only guaranteed to exist in the
  // sendMessage response. Persisted here at send time and read back at
  // verify time instead of trusting callback_query.message to carry it,
  // since deletion silently failed in production when it was read straight
  // off the callback update.
  captchaChallengeEphemeralMessageId Int?
  // Set when this member joined via a tracked invite link (see
  // ChatInviteLink) -- cleared once a "left" event has been attributed back
  // to that link, so a later organic leave (no fresh join in between) is
  // never double-counted against a stale link.
  joinedViaInviteLinkId          String?            @db.Uuid
  createdAt                      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt                      DateTime           @updatedAt @db.Timestamptz(3)
  chat                           Chat               @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user                           TelegramUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberTag                      ChatMemberTag?
  joinedViaInviteLink            ChatInviteLink?    @relation(fields: [joinedViaInviteLinkId], references: [id], onDelete: SetNull)

  @@unique([chatId, userId])
  @@index([chatId, status, lastSeenAt(sort: Desc)])
  @@index([status, lastSeenAt(sort: Desc)])
  @@index([punishmentState, punishmentExpiresAt])
  @@index([userId])
  @@index([joinedViaInviteLinkId])
}

// Bot-created Telegram invite links tracked for per-link join/leave
// statistics -- see chat-invite-link-service.ts. Telegram's Bot API has no
// hard "delete", only revoke (createChatInviteLink/editChatInviteLink/
// revokeChatInviteLink); "Удалить" in the panel maps to revoke + removing
// this row, matching CLAUDE.md's no-fake-actions rule (we never pretend a
// revoked-but-still-technically-existing link was deleted from Telegram).
model ChatInviteLink {
  id                 String       @id @default(uuid()) @db.Uuid
  chatId             String       @db.Uuid
  telegramInviteLink String       @unique
  name               String?
  memberLimit        Int?
  expiresAt          DateTime?    @db.Timestamptz(3)
  createsJoinRequest Boolean      @default(false)
  isRevoked          Boolean      @default(false)
  joinedCount        Int          @default(0)
  leftCount          Int          @default(0)
  createdByAdminId   String?      @db.Uuid
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(3)
  chat               Chat         @relation(fields: [chatId], references: [id], onDelete: Cascade)
  createdByAdmin     AdminUser?   @relation("ChatInviteLinkCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  members            ChatMember[]

  @@index([chatId])
}

model ChatMemberTag {
  id           String     @id @default(uuid()) @db.Uuid
  chatMemberId String     @unique @map("chat_member_id") @db.Uuid
  tag          String     @db.VarChar(16)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  chatMember   ChatMember @relation(fields: [chatMemberId], references: [id], onDelete: Cascade)

  @@map("chat_member_tags")
}

model Message {
  id                String        @id @default(uuid()) @db.Uuid
  chatId            String        @db.Uuid
  senderUserId      String?       @db.Uuid
  telegramMessageId BigInt
  telegramDate      DateTime      @db.Timestamptz(3)
  editedAt          DateTime?     @db.Timestamptz(3)
  text              String?       @db.Text
  caption           String?       @db.Text
  messageType       String
  isEdited          Boolean       @default(false)
  automodRevisionAt DateTime?     @db.Timestamptz(3)
  automodClaimedAt  DateTime?     @db.Timestamptz(3)
  automodResult     String?       @db.VarChar(50)
  deletedAt         DateTime?     @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  chat              Chat          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender            TelegramUser? @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@unique([chatId, telegramMessageId])
  @@index([chatId, telegramDate(sort: Desc)])
  @@index([senderUserId, telegramDate(sort: Desc)])
}

model JoinRequest {
  id                String            @id @default(uuid()) @db.Uuid
  chatId            String            @db.Uuid
  userId            String            @db.Uuid
  telegramUpdateId  BigInt            @unique
  userChatId        BigInt?
  bio               String?           @db.VarChar(500)
  inviteLink        String?           @db.Text
  status            JoinRequestStatus @default(PENDING)
  requestedAt       DateTime          @db.Timestamptz(3)
  processingAt      DateTime?         @db.Timestamptz(3)
  resolvedAt        DateTime?         @db.Timestamptz(3)
  resolvedByAdminId String?           @db.Uuid
  telegramError     String?           @db.VarChar(500)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)
  chat              Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user              TelegramUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  resolvedByAdmin   AdminUser?        @relation("JoinRequestResolver", fields: [resolvedByAdminId], references: [id], onDelete: SetNull)

  @@index([status, requestedAt(sort: Desc)])
  @@index([chatId, status, requestedAt(sort: Desc)])
  @@index([userId, requestedAt(sort: Desc)])
  @@index([processingAt])
}

model ChatModerationSettings {
  id                     String   @id @default(uuid()) @db.Uuid
  chatId                 String   @unique @db.Uuid
  // Deprecated: superseded by linkProtectionMode below (kept, unread by app
  // code — same deprecation convention as the escalation fields further down).
  blockLinks             Boolean  @default(false)
  // "ALLOW_ALL" | "BLOCK_ALL" | "WHITELIST_ONLY" | "BLACKLIST_ONLY" — BOT_PRODUCT_SPEC §22.
  linkEnabled            Boolean  @default(false)
  linkProtectionMode     String   @default("ALLOW_ALL")
  allowedDomains         String[] @default([])
  blockedDomains         String[] @default([])
  spamEnabled            Boolean  @default(false)
  spamWindowSeconds      Int      @default(10)
  spamMaxMessages        Int      @default(5)
  blockedTermsEnabled    Boolean  @default(false)
  blockedTerms           String[] @default([])
  massMentionsEnabled    Boolean  @default(false)
  maxMentions            Int      @default(5)
  duplicateEnabled       Boolean  @default(false)
  duplicateWindowSeconds Int      @default(60)
  duplicateMaxMessages   Int      @default(2)
  ignoreAdmins           Boolean  @default(true)
  autoEscalationEnabled  Boolean  @default(false)
  // Deprecated: superseded by escalationRules below (kept, unread by app
  // code, so a rollback or a stray old query doesn't lose data — drop in a
  // later migration once escalationRules has been live for a while).
  muteAfterWarnings      Int      @default(3)
  muteDurationMinutes    Int      @default(10)
  banAfterWarnings       Int      @default(6)
  // Ordered chain of EscalationRuleValue: [{ order, thresholdWarnings, action: "MUTE"|"BAN", durationMinutes }].
  escalationRules        Json     @default("[]")
  warningExpiryDays      Int      @default(0)
  announceEscalationEnabled     Boolean  @default(false)
  escalationMuteMessageTemplate String   @default("🔇 %target% получил(а) mute на %duration% за нарушение правил чата. Предупреждений: %warns% из %warns_limit%.") @db.VarChar(1000)
  escalationBanMessageTemplate  String   @default("⛔ %target% заблокирован(а) за нарушение правил чата. Предупреждений: %warns% из %warns_limit%.") @db.VarChar(1000)
  // Per-content-type "Фильтры" (§ Filters module): granular rules for every
  // restrictable content type (all 12 -- the old flat blockedMessageTypes
  // list has been removed entirely) — MediaFilterRule[] from
  // global-moderation-service.ts: [{ type: "PHOTO"|"VIDEO"|"ANIMATION"|
  // "VOICE"|"AUDIO"|"VIDEO_NOTE"|"DICE"|"DOCUMENT"|"STICKER"|"POLL"|
  // "LOCATION"|"CONTACT", enabled, deleteMessage, punishmentEnabled,
  // punishmentAction, muteDurationMinutes, notifyEnabled, notifyText }].
  mediaFilters           Json     @default("[]")
  // Per-rule outcomes for LINK/TERM/SPAM/DUPLICATE/MENTIONS. Detection
  // settings stay in their existing typed columns; this JSON only controls
  // delete/punishment/notification behavior in a forward-compatible shape.
  ruleActions            Json     @default("[]")
  createdAt              DateTime @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @db.Timestamptz(3)
  chat                   Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model GlobalModerationSettings {
  id                     String   @id @default("global")
  // Deprecated: superseded by linkProtectionMode below (kept, unread by app
  // code — same deprecation convention as the escalation fields further down).
  blockLinks             Boolean  @default(false)
  // "ALLOW_ALL" | "BLOCK_ALL" | "WHITELIST_ONLY" | "BLACKLIST_ONLY" — BOT_PRODUCT_SPEC §22.
  linkProtectionMode     String   @default("ALLOW_ALL")
  allowedDomains         String[] @default([])
  blockedDomains         String[] @default([])
  spamEnabled            Boolean  @default(false)
  spamWindowSeconds      Int      @default(10)
  spamMaxMessages        Int      @default(5)
  blockedTermsEnabled    Boolean  @default(false)
  blockedTerms           String[] @default([])
  massMentionsEnabled    Boolean  @default(false)
  maxMentions            Int      @default(5)
  duplicateEnabled       Boolean  @default(false)
  duplicateWindowSeconds Int      @default(60)
  duplicateMaxMessages   Int      @default(2)
  ignoreAdmins           Boolean  @default(true)
  autoEscalationEnabled  Boolean  @default(false)
  // Deprecated: superseded by escalationRules below (kept, unread by app
  // code, so a rollback or a stray old query doesn't lose data — drop in a
  // later migration once escalationRules has been live for a while).
  muteAfterWarnings      Int      @default(3)
  muteDurationMinutes    Int      @default(10)
  banAfterWarnings       Int      @default(6)
  // Ordered chain of EscalationRuleValue: [{ order, thresholdWarnings, action: "MUTE"|"BAN", durationMinutes }].
  escalationRules        Json     @default("[]")
  warningExpiryDays      Int      @default(0)
  announceEscalationEnabled     Boolean  @default(false)
  escalationMuteMessageTemplate String   @default("🔇 %target% получил(а) mute на %duration% за нарушение правил чата. Предупреждений: %warns% из %warns_limit%.") @db.VarChar(1000)
  escalationBanMessageTemplate  String   @default("⛔ %target% заблокирован(а) за нарушение правил чата. Предупреждений: %warns% из %warns_limit%.") @db.VarChar(1000)
  createdAt              DateTime @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @db.Timestamptz(3)
}

model ChatCaptchaSettings {
  id                       String   @id @default(uuid()) @db.Uuid
  chatId                   String   @unique @db.Uuid
  enabled                  Boolean  @default(false)
  challengeMessageTemplate String   @default("Подтвердите, что вы не бот — нажмите кнопку ниже. Пока не подтвердите, вы не сможете писать в этом чате; если долго не подтвердите, вас исключат (без блокировки — сможете зайти снова).") @db.VarChar(1000)
  challengeButtonText      String   @default("✅ Я не бот") @db.VarChar(64)
  deleteAfterVerification  Boolean  @default(true)
  createdAt                DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime @updatedAt @db.Timestamptz(3)
  chat                     Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model ChatAntiRaidSettings {
  id               String   @id @default(uuid()) @db.Uuid
  chatId           String   @unique @db.Uuid
  enabled          Boolean  @default(false)
  joinThreshold    Int      @default(30)
  windowSeconds    Int      @default(20)
  // How long without a new join before an active raid is considered over —
  // resolved by the same daily cron that sweeps captcha timeouts/mute
  // expiry (no more-frequent cron on the free Vercel plan, see docs/STAGE_2.md).
  cooldownMinutes  Int      @default(15)
  forceCaptcha     Boolean  @default(true)
  // While a raid is active, lock the whole chat down via the same
  // setChatPermissions mechanism /silence uses (moderators/admins keep
  // posting on their own native rights) -- re-applied on every join while
  // the raid stays active so the lock's expiry tracks cooldownMinutes, and
  // self-lifts through the existing silence-expiry cron once joins stop.
  lockChat         Boolean  @default(false)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
  chat             Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

// One row per detected raid, from first crossing the join threshold until
// resolved (see anti-raid-service.ts). lastJoinAt drives resolution: the
// daily cron closes any ACTIVE incident whose lastJoinAt is older than its
// chat's cooldownMinutes.
model RaidIncident {
  id            String    @id @default(uuid()) @db.Uuid
  chatId        String    @db.Uuid
  status        String    @default("ACTIVE")
  startedAt     DateTime  @default(now()) @db.Timestamptz(3)
  lastJoinAt    DateTime  @default(now()) @db.Timestamptz(3)
  resolvedAt    DateTime? @db.Timestamptz(3)
  peakJoinCount Int       @default(0)
  chat          Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, status])
}

model ChatManualModerationSettings {
  id                         String   @id @default(uuid()) @db.Uuid
  chatId                     String   @unique @db.Uuid
  warnMessageTemplate         String   @default("⚠️ %target% получил(а) предупреждение (%warns% из %warns_limit%). %reason%") @db.VarChar(1000)
  warnDeleteTargetMessage     Boolean  @default(false)
  warnEphemeralMessageTemplate String  @default("⚠️ В чате «%chat%» вам выдано: предупреждение. %reason%\n\nЧтобы оспорить или узнать детали, напишите %contact%") @db.VarChar(1000)
  unwarnMessageTemplate      String   @default("✅ С %target% снято предупреждение (осталось %warns% из %warns_limit%).") @db.VarChar(1000)
  unwarnDeleteTargetMessage  Boolean  @default(false)
  muteMessageTemplate        String   @default("🔇 %target% получил(а) mute на %duration%. %reason%") @db.VarChar(1000)
  muteDeleteTargetMessage    Boolean  @default(false)
  muteEphemeralMessageTemplate String @default("⚠️ В чате «%chat%» вам выдано: временное ограничение (mute). %reason%\n\nЧтобы оспорить или узнать детали, напишите %contact%") @db.VarChar(1000)
  unmuteMessageTemplate      String   @default("🔊 С %target% снят mute.") @db.VarChar(1000)
  unmuteDeleteTargetMessage  Boolean  @default(false)
  banMessageTemplate         String   @default("⛔ %target% заблокирован(а). %reason%") @db.VarChar(1000)
  banDeleteTargetMessage     Boolean  @default(false)
  banEphemeralMessageTemplate String  @default("⚠️ В чате «%chat%» вам выдано: блокировка (ban). %reason%\n\nЧтобы оспорить или узнать детали, напишите %contact%") @db.VarChar(1000)
  unbanMessageTemplate       String   @default("✅ С %target% снята блокировка.") @db.VarChar(1000)
  unbanDeleteTargetMessage   Boolean  @default(false)
  kickMessageTemplate        String   @default("👢 %target% исключён(а) из чата. %reason%") @db.VarChar(1000)
  kickDeleteTargetMessage    Boolean  @default(false)
  commandProfiles            Json     @default("[]")
  createdAt                  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime @updatedAt @db.Timestamptz(3)
  chat                       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model GlobalManualModerationSettings {
  id                         String   @id @default("global")
  // Single source of truth for whether punishment notices go out at all --
  // no per-chat or per-command override (see manual-moderation-settings.tsx).
  publicPunishmentMessagesEnabled  Boolean @default(true)
  privatePunishmentMessagesEnabled Boolean @default(true)
  // Unified event/channel profiles used by the moderation notification
  // center. Empty means "derive from the legacy fields above/below" so the
  // rollout preserves every installation's current behaviour.
  notificationProfiles             Json    @default("[]")
  warnMessageTemplate         String   @default("⚠️ %target% получил(а) предупреждение (%warns% из %warns_limit%). %reason%") @db.VarChar(1000)
  warnDeleteTargetMessage     Boolean  @default(false)
  warnEphemeralMessageTemplate String  @default("⚠️ В чате «%chat%» вам выдано: предупреждение. %reason%\n\nЧтобы оспорить или узнать детали, напишите %contact%") @db.VarChar(1000)
  unwarnMessageTemplate      String   @default("✅ С %target% снято предупреждение (осталось %warns% из %warns_limit%).") @db.VarChar(1000)
  unwarnDeleteTargetMessage  Boolean  @default(false)
  muteMessageTemplate        String   @default("🔇 %target% получил(а) mute на %duration%. %reason%") @db.VarChar(1000)
  muteDeleteTargetMessage    Boolean  @default(false)
  muteEphemeralMessageTemplate String @default("⚠️ В чате «%chat%» вам выдано: временное ограничение (mute). %reason%\n\nЧтобы оспорить или узнать детали, напишите %contact%") @db.VarChar(1000)
  unmuteMessageTemplate      String   @default("🔊 С %target% снят mute.") @db.VarChar(1000)
  unmuteDeleteTargetMessage  Boolean  @default(false)
  banMessageTemplate         String   @default("⛔ %target% заблокирован(а). %reason%") @db.VarChar(1000)
  banDeleteTargetMessage     Boolean  @default(false)
  banEphemeralMessageTemplate String  @default("⚠️ В чате «%chat%» вам выдано: блокировка (ban). %reason%\n\nЧтобы оспорить или узнать детали, напишите %contact%") @db.VarChar(1000)
  unbanMessageTemplate       String   @default("✅ С %target% снята блокировка.") @db.VarChar(1000)
  unbanDeleteTargetMessage   Boolean  @default(false)
  kickMessageTemplate        String   @default("👢 %target% исключён(а) из чата. %reason%") @db.VarChar(1000)
  kickDeleteTargetMessage    Boolean  @default(false)
  createdAt                  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime @updatedAt @db.Timestamptz(3)
}

model ModerationAction {
  id             String                 @id @default(uuid()) @db.Uuid
  chatId         String                 @db.Uuid
  affectedUserId String                 @db.Uuid
  actingAdminId  String?                @db.Uuid
  source         AuditSource            @default(ADMIN)
  type           ModerationActionType
  status         ModerationActionStatus @default(PENDING)
  reason         String?                @db.VarChar(500)
  expiresAt      DateTime?              @db.Timestamptz(3)
  completedAt    DateTime?              @db.Timestamptz(3)
  telegramError  String?                @db.VarChar(500)
  revokedAt      DateTime?               @db.Timestamptz(3)
  revokedByAdminId String?               @db.Uuid
  revocationReason String?               @db.VarChar(500)
  triggeredPunishmentActionId String?    @unique @db.Uuid
  metadata       Json?
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)
  chat           Chat                   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  affectedUser   TelegramUser           @relation("ModeratedUser", fields: [affectedUserId], references: [id], onDelete: Cascade)
  actingAdmin    AdminUser?             @relation("ModerationActor", fields: [actingAdminId], references: [id], onDelete: Restrict)
  revokedByAdmin AdminUser?             @relation("WarningRevoker", fields: [revokedByAdminId], references: [id], onDelete: SetNull)
  triggeredPunishmentAction ModerationAction? @relation("WarningTriggeredPunishment", fields: [triggeredPunishmentActionId], references: [id], onDelete: SetNull)
  triggeredByWarning ModerationAction?  @relation("WarningTriggeredPunishment")
  appeal         Appeal?

  @@index([chatId, createdAt(sort: Desc)])
  @@index([affectedUserId, createdAt(sort: Desc)])
  @@index([actingAdminId, createdAt(sort: Desc)])
  @@index([source, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@index([chatId, affectedUserId, type, revokedAt, createdAt(sort: Desc)])
  @@index([revokedByAdminId, revokedAt(sort: Desc)])
  @@index([expiresAt, status])
}

// Per-chat toggle for the /appeal flow, plus its notification fan-out --
// replaces the removed appealDmMessageId reply-matching mechanism and the
// dropped GlobalManualModerationSettings.proactiveDmNotificationsEnabled
// (that field's only reader is now this table's notifyUserOnDecision, scoped
// per chat instead of globally). All three booleans default true so an
// existing chat's behavior doesn't silently change when this table is
// introduced -- no row yet means "on", same as before this feature existed.
model ChatAppealSettings {
  id                    String   @id @default(uuid()) @db.Uuid
  chatId                String   @unique @db.Uuid
  enabled               Boolean  @default(true)
  notifyAdminsOnSubmit  Boolean  @default(true)
  notifyUserOnDecision  Boolean  @default(true)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)
  chat                  Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

// Editable templates for the three appeal-flow texts that used to be inline
// string literals (appeal-notification-service.ts / update-handler.ts) --
// global-only, same as GlobalCaptchaSettings.challengeMessageTemplate: no
// per-chat override, edited under Система → Уведомления.
model GlobalAppealSettings {
  id                                 String   @id @default("global")
  appealSubmittedMessageTemplate     String   @default("Апелляция отправлена администраторам. Дождитесь решения.") @db.VarChar(1000)
  appealNotifyAdminsMessageTemplate  String   @default("Новая апелляция от %user% по чату «%chat%» (%action%):\n%message%") @db.VarChar(1000)
  appealApprovedMessageTemplate      String   @default("Ваша апелляция по чату «%chat%» одобрена, наказание отменено.%comment%") @db.VarChar(1000)
  appealRejectedMessageTemplate      String   @default("Ваша апелляция по чату «%chat%» отклонена.%comment%") @db.VarChar(1000)
  createdAt                          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                          DateTime @updatedAt @db.Timestamptz(3)
}

model Appeal {
  id                 String       @id @default(uuid()) @db.Uuid
  chatId             String       @db.Uuid
  userId             String       @db.Uuid
  moderationActionId String       @unique @db.Uuid
  status             AppealStatus @default(PENDING)
  message            String       @db.VarChar(2000)
  resolvedByAdminId  String?      @db.Uuid
  resolutionComment  String?      @db.VarChar(1000)
  resolvedAt         DateTime?    @db.Timestamptz(3)
  resolutionAttemptId String?     @db.Uuid
  resolutionStartedAt DateTime?   @db.Timestamptz(3)
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(3)
  chat               Chat             @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user               TelegramUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moderationAction   ModerationAction @relation(fields: [moderationActionId], references: [id], onDelete: Cascade)
  resolvedByAdmin    AdminUser?       @relation("AppealResolver", fields: [resolvedByAdminId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([status, resolutionStartedAt])
  @@index([chatId, status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

// BOT_PRODUCT_SPEC §32: a member reply-reports another member's message;
// moderators resolve it via a private Telegram card with action buttons
// (see report-service.ts's buildReportCallbackData / resolveReport).
model Report {
  id                String       @id @default(uuid()) @db.Uuid
  chatId            String       @db.Uuid
  reporterUserId    String       @db.Uuid
  reportedUserId    String       @db.Uuid
  messageTelegramId BigInt?
  reason            String?      @db.VarChar(500)
  status            ReportStatus @default(PENDING)
  // Set only when status = RESOLVED: "DELETE" | "WARN" | "MUTE" | "BAN".
  resolutionAction  String?
  resolvedByAdminId String?      @db.Uuid
  resolvedAt        DateTime?    @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)
  chat              Chat         @relation(fields: [chatId], references: [id], onDelete: Cascade)
  reporter          TelegramUser @relation("ReportReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  reportedUser      TelegramUser @relation("ReportReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  resolvedByAdmin   AdminUser?   @relation("ReportResolver", fields: [resolvedByAdminId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([chatId, status, createdAt(sort: Desc)])
  @@index([reportedUserId, createdAt(sort: Desc)])
}

model ChatReportSettings {
  id                  String   @id @default(uuid()) @db.Uuid
  chatId              String   @unique @db.Uuid
  enabled             Boolean  @default(true)
  // Fixed duration used by the report card's "Ограничить" quick action --
  // an inline button can't collect a custom value, see report-service.ts.
  muteDurationMinutes Int      @default(60)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)
  chat                Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

// Optional per-chat log channel (BOT_PRODUCT_SPEC §38): forwards a summary
// of moderation events to a separate Telegram channel/group. Deliberately
// chat-only, no Global+useGlobalProfile pair like every other settings
// domain -- a channel id is inherently chat-specific data, not a shared
// policy default. Linked via a forwarded-message flow (see
// log-channel-service.ts): pendingLinkAdminId/pendingLinkExpiresAt track a
// short-lived "waiting for you to forward a post from the channel" window.
model ChatLogChannelSettings {
  id                    String    @id @default(uuid()) @db.Uuid
  chatId                String    @unique @db.Uuid
  enabled               Boolean   @default(false)
  logChannelTelegramId  BigInt?
  logChannelTitle       String?
  pendingLinkAdminId    String?   @db.Uuid
  pendingLinkExpiresAt  DateTime? @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  chat                  Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

// Welcome (§30) + Rules (§29) -- grouped into one settings domain since both
// are just chat-facing text content shown to members, matching how the
// Settings Center's own "Чат" section groups them together.
model ChatContentSettings {
  id                     String   @id @default(uuid()) @db.Uuid
  chatId                 String   @unique @db.Uuid
  welcomeEnabled         Boolean  @default(false)
  welcomeMessageTemplate String   @default("Добро пожаловать, {name}! 👋\n\nЧат «{group}» рад видеть вас — сейчас в нём {member_count} участников.") @db.VarChar(2000)
  welcomeButtons         Json     @default("[]")
  muteNewMembersMinutes  Int      @default(0)
  blockRtlNames          Boolean  @default(false)
  blockChatFolderJoins   Boolean  @default(false)
  blockInvitedBots       Boolean  @default(false)
  blockMissingUsername   Boolean  @default(false)
  maxNameLength          Int      @default(0)
  blockedNamePatterns    String[] @default([])
  checkExistingMembers   Boolean  @default(false)
  createdAt              DateTime @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @db.Timestamptz(3)
  chat                   Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

// Silence Mode (§28): /silence [duration] locks the chat down for regular
// members via Telegram's real setChatPermissions (chat-wide default member
// permissions -- distinct from per-user restrictChatMember) while
// moderators/admins keep posting on their own native rights. One row per
// chat, present only while active. previousPermissions snapshots the chat's
// actual permissions right before locking (via getChat) so unsilencing
// restores exactly what was there, not just "everything allowed" -- a chat
// that already had e.g. polls/media disabled shouldn't have that reset too.
// Resolved by the same daily cron that sweeps mute/ban/captcha expiry.
model ChatSilenceState {
  id                      String    @id @default(uuid()) @db.Uuid
  chatId                  String    @unique @db.Uuid
  startedAt               DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt               DateTime? @db.Timestamptz(3)
  previousPermissions     Json?
  startedByTelegramUserId BigInt?
  startedByDisplayName    String?
  chat                    Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

// Auto Responses (§42, Phase 10): keyword/phrase-triggered automatic
// replies, checked against every regular group message (not a /command).
// Chat-only, like Log Channel/Silence -- a list of custom triggers is
// inherently per-chat content, not a shared policy default. Full CRUD
// (add/edit/delete a rule) is Web Admin-only -- Telegram inline buttons
// can't collect the free-text trigger/response pair, same "no free-text
// editing via buttons" line drawn everywhere else in the Settings Center.
model AutoResponseRule {
  id           String              @id @default(uuid()) @db.Uuid
  chatId       String              @db.Uuid
  trigger      String              @db.VarChar(200)
  matchType    AutoResponseMatch   @default(CONTAINS)
  responseText String              @db.VarChar(1000)
  enabled      Boolean             @default(true)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)
  chat         Chat                @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, enabled])
}

enum AutoResponseMatch {
  CONTAINS
  EXACT
}

// Custom Commands (§41, Phase 10): admin-defined /commands with a canned
// text response, e.g. /price /faq /contacts. Chat-only, same reasoning as
// AutoResponseRule -- a list of custom commands is per-chat content, not a
// shared policy default. trigger is the bare command word (no leading
// slash, matching how Telegram's own BotCommand.command works) and is
// unique per chat so two rules can't silently shadow each other.
// adminOnly is the spec's "permissions" field, scoped down to a single
// boolean (invocable by everyone vs. staff only) rather than the full
// ChatPermission vocabulary -- reuses the same "automod.manage" staff gate
// /settings itself is already checked against, instead of inventing a new
// permission just for this.
model CustomCommand {
  id           String   @id @default(uuid()) @db.Uuid
  chatId       String   @db.Uuid
  trigger      String   @db.VarChar(32)
  responseText String   @db.VarChar(1000)
  adminOnly    Boolean  @default(false)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  chat         Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, trigger])
  @@index([chatId, enabled])
}

model AdminUser {
  id                        String             @id @default(uuid()) @db.Uuid
  // Nullable: a Telegram-only self-registered (scope: CHAT) account has
  // neither an email nor a password — see migration for the partial unique
  // index (WHERE email IS NOT NULL) that lets multiple such rows coexist.
  email                     String?            @unique
  displayName               String
  passwordHash              String?
  role                      AdminRole          @default(VIEWER)
  // GLOBAL (default) = unchanged existing behavior, sees every chat via
  // `role`. CHAT = self-registered via Telegram login, scoped to chats in
  // `chatAdminAccess`; `role` stays the inert default "VIEWER" and is never
  // consulted for these accounts (see chat-admin-access-service.ts).
  scope                     AdminScope         @default(GLOBAL)
  isActive                  Boolean            @default(true)
  telegramUserId            BigInt?            @unique
  telegramUsername          String?
  telegramFirstName         String?
  telegramLinkCode          String?
  telegramLinkCodeExpiresAt DateTime?          @db.Timestamptz(3)
  lastLoginAt               DateTime?          @db.Timestamptz(3)
  createdAt                 DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime           @updatedAt @db.Timestamptz(3)
  sessions                  AdminSession[]
  moderationActions         ModerationAction[] @relation("ModerationActor")
  revokedWarnings           ModerationAction[] @relation("WarningRevoker")
  resolvedJoinRequests      JoinRequest[]       @relation("JoinRequestResolver")
  auditLogs                 AuditLog[]         @relation("ActingAdmin")
  resolvedAppeals           Appeal[]           @relation("AppealResolver")
  resolvedReports           Report[]           @relation("ReportResolver")
  chatAdminAccess           ChatAdminAccess[]  @relation("ChatAdminAccessAdmin")
  grantedChatAdminAccess    ChatAdminAccess[]  @relation("ChatAdminAccessGrantedBy")
  telegramLoginRequests     TelegramLoginRequest[]
  createdInviteLinks        ChatInviteLink[]        @relation("ChatInviteLinkCreatedBy")

  @@index([role, isActive])
  @@index([scope])
}

// Web-panel visibility gate for a chat. See chat-admin-access-service.ts.
model ChatAdminAccess {
  id               String              @id @default(uuid()) @db.Uuid
  chatId           String              @db.Uuid
  adminId          String              @db.Uuid
  role             ChatAdminAccessRole @default(ADMIN)
  // "AUTO" = discovered from cached live Telegram CREATOR/ADMINISTRATOR
  // status on login; "MANUAL" = added via a chat's Команда tab.
  grantedVia       String
  grantedByAdminId String?             @db.Uuid
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)
  chat             Chat                @relation(fields: [chatId], references: [id], onDelete: Cascade)
  admin            AdminUser           @relation("ChatAdminAccessAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  grantedByAdmin   AdminUser?          @relation("ChatAdminAccessGrantedBy", fields: [grantedByAdminId], references: [id], onDelete: SetNull)

  @@unique([chatId, adminId])
  @@index([adminId])
  @@index([chatId])
}

// Backs the "Войти через Telegram" login flow via a t.me/<bot>?start=login_<token>
// deep link (see telegram-login-request-service.ts) rather than Telegram's JS login
// widget -- opening a t.me link lets Telegram's own app handle picking which of the
// user's signed-in accounts to use, which the widget (tied to whatever browser
// session is active) can't offer. Single-use: resolveTelegramLoginRequest only ever
// matches a row still in PENDING, so a second /start with the same token is a no-op.
model TelegramLoginRequest {
  id              String    @id @default(uuid()) @db.Uuid
  tokenHash       String    @unique
  status          String    @default("PENDING") // PENDING | COMPLETED | FAILED
  resolvedAdminId String?   @db.Uuid
  errorCode       String?
  expiresAt       DateTime  @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  resolvedAdmin   AdminUser? @relation(fields: [resolvedAdminId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
}

model AdminSession {
  id         String    @id @default(uuid()) @db.Uuid
  adminId    String    @db.Uuid
  tokenHash  String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, expiresAt])
  @@index([expiresAt])
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  chatId         String?       @db.Uuid
  affectedUserId String?       @db.Uuid
  actingAdminId  String?       @db.Uuid
  source         AuditSource
  action         String
  reason         String?
  metadata       Json?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  chat           Chat?         @relation(fields: [chatId], references: [id], onDelete: SetNull)
  affectedUser   TelegramUser? @relation("AffectedUser", fields: [affectedUserId], references: [id], onDelete: SetNull)
  actingAdmin    AdminUser?    @relation("ActingAdmin", fields: [actingAdminId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([chatId, createdAt(sort: Desc)])
  @@index([affectedUserId, createdAt(sort: Desc)])
  @@index([actingAdminId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}
