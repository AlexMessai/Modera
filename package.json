{
  "name": "modera",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "if [ \"$VERCEL_ENV\" = \"production\" ]; then npm run db:migrate && npm run db:seed && next build && npm run telegram:set-webhook; else next build && npm run telegram:set-webhook; fi",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test src/server/auth/permissions.test.ts src/server/telegram/status.test.ts src/server/telegram/webhook-secret.test.ts src/server/services/member-service.test.ts src/server/services/moderation-service.test.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "telegram:set-webhook": "tsx scripts/set-webhook.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.6.1",
    "lucide-react": "^0.468.0",
    "next": "16.3.0",
    "pg": "^8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.34.0",
    "eslint-config-next": "16.3.0",
    "prisma": "^7.4.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
